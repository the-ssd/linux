			odpm {
				chip-name = "S2MPG15";
				sample-rate-uhz = <0x7735940>;
				sample-rate-external-uhz = <0x1dcd650>;
				max-refresh-time-ms = <0x6ddd00>;

				channels {

					channel@0 {
						rail-name = "BUCK1S";
						channel_enabled;
					};

					channel@1 {
						rail-name = "BUCK2S";
						channel_enabled;
					};

					channel@2 {
