	cp_shmem {
		compatible = "samsung,exynos-cp-shmem";
		memory-region = <0x25a 0x25b 0x25c 0x25d>;
		cp_num = <0x00>;
		use_mem_map_on_cp = <0x00>;

		regions {

			ipc {
				region,name = "IPC";
				region,index = <0x03>;
				region,rmem = <0x00>;
				region,offset = <0x00>;
				region,size = <0x800000>;
				region,cached = <0x01>;
			};

			msi {
				region,name = "MSI";
				region,index = <0x0b>;
				region,rmem = <0x01>;
				region,offset = <0x00>;
				region,size = <0x1000>;
				region,cached = <0x00>;
			};

			pktproc {
				region,name = "PKTPROC";
				region,index = <0x07>;
				region,rmem = <0x02>;
				region,offset = <0x00>;
				region,size = <0x1c00000>;
			};

			pktproc_ul {
				region,name = "PKTPROC_UL";
				region,index = <0x08>;
				region,rmem = <0x02>;
				region,offset = <0x1c00000>;
				region,size = <0x400000>;
			};

			vss_aoc {
				region,name = "VSS_AOC";
				region,index = <0x01>;
				region,rmem = <0x03>;
				region,offset = <0x00>;
				region,size = <0x3000>;
				region,cached = <0x00>;
			};

			gnss_fw {
				region,name = "GNSS_FW";
				region,index = <0x0d>;
				region,rmem = <0x00>;
				region,offset = <0x800000>;
				region,size = <0x400000>;
				region,cached = <0x01>;
			};
		};
	};

	s5910_bb {
		compatible = "google,bitbang-spmi-controller";
		status = "okay";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		clk-gpio = <0x2ca 0x00 0x00>;
		dat-gpio = <0x2ca 0x01 0x00>;
		delay_us = <0x0a>;

		s5910@5 {
			reg = <0x05 0x00>;
			compatible = "google,s5910-spmi";
			s5910,seq = <0x00 0x215 0x0f 0x3e8 0x20e 0x04 0x00 0x240 0x10>;
			phandle = <0x421>;
		};
	};

	gnssif {
		status = "okay";
		compatible = "samsung,exynos-gnss";
		device,name = "KEPLER";
		device_node_name = "gnss_ipc";
		pinctrl-names = "default";
		pinctrl-0 = <0x422 0x423>;
		gpio_gnss2ap_spi = <0x2d8 0x04 0x01>;
		gpio_ap2gnss_spi = <0x95 0x03 0x01>;
	};

	tbn {
		compatible = "touch_bus_negotiator";
		tbn,mode = <0x02>;
	};

	google,usbc_port_cooling_dev {
		extcon = <0x414>;
		compatible = "google,usbc_port_cooling_dev";
		google,usb-cd-polling-interval-ms = <0x1388>;
		google,usb-cd-connected-interval-ms = <0x2bc>;
		google,usb-cd-unplug-interval-sec = <0x02>;
		#cooling-cells = <0x02>;
	};

	sbb-mux {
		compatible = "google,sbb-mux";
		gpios = <0x97 0x03 0x00 0xa4 0x06 0x00 0xa4 0x07 0x00>;
		gpio_names = "C1_T0__XAPC_USI2_CTSn_CSn", "C1_T1__XAPC_USI9_RTSn_DI", "C1_T2__XAPC_USI9_CTSn_CSn";
		default_signals = "gp_region_0", "gp_region_1", "gp_region_2";
	};

	module_power_seq@0 {
		power-up-seqs = "pp3200_bb", "pp1350", "s2mpg15_ldo12", "ldo2", "ldo7", "reset", "mclk_on";
		power-up-seq-types = "regulator", "regulator", "regulator", "regulator", "regulator", "gpio", "pinctrl";
		power-up-seq-delays-us = <0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8>;
		power-down-seqs = "mclk_off", "reset", "ldo7", "ldo2", "s2mpg15_ldo12", "pp1350", "pp3200_bb";
		power-down-seq-types = "pinctrl", "gpio", "regulator", "regulator", "regulator", "regulator", "regulator";
		power-down-seq-delays-us = <0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8>;
		phandle = <0x461>;
	};

	module_power_seq@1 {
		power-up-seqs = "pp3200_bb", "pp1350", "s2mpg15_ldo12", "ldo5", "ldo4", "ldo1", "vdig_enable", "reset", "mclk_on";
		power-up-seq-types = "regulator", "regulator", "regulator", "regulator", "regulator", "regulator", "gpio", "gpio", "pinctrl";
		power-up-seq-delays-us = <0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x2710>;
		power-down-seqs = "mclk_off", "reset", "vdig_enable", "ldo1", "ldo4", "ldo5", "s2mpg15_ldo12", "pp1350", "pp3200_bb";
		power-down-seq-types = "pinctrl", "gpio", "gpio", "regulator", "regulator", "regulator", "regulator", "regulator", "regulator";
		power-down-seq-delays-us = <0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8>;
		phandle = <0x45c>;
	};

	module_power_seq@2 {
		power-up-seqs = "pp3200_bb", "pp1350", "s2mpg15_ldo12", "ldo3", "ldo6", "reset", "mclk_on";
		power-up-seq-types = "regulator", "regulator", "regulator", "regulator", "regulator", "gpio", "pinctrl";
		power-up-seq-delays-us = <0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8>;
