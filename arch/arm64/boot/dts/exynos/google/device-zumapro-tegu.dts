						channel_enabled;
					};

					channel@9 {
						rail-name = "VSEN_C4";
						channel_enabled;
					};

					channel@10 {
						rail-name = "VSEN_C5";
						channel_enabled;
					};

					channel@11 {
						rail-name = "VSEN_C6";
						channel_enabled;
					};
				};

				rails {
					use-regulators-as-rails;

					VSEN_C4 {
						external_rail;
						channel-en-index = <0x01>;
						channel-mux-selection = <0x5c>;
						shunt-res-uohms = <0x1388>;
						schematic-name = "VSYS_PWR_MODEM";
						subsys-name = "MODEM";
					};

					VSEN_C5 {
						external_rail;
						channel-en-index = <0x02>;
						channel-mux-selection = <0x5d>;
						shunt-res-uohms = <0x2710>;
						schematic-name = "VSYS_PWR_WLAN_BT";
						subsys-name = "WLAN-BT";
					};

					VSEN_C6 {
						external_rail;
						channel-en-index = <0x04>;
						channel-mux-selection = <0x5e>;
						shunt-res-uohms = <0x2710>;
						schematic-name = "VSYS_PWR_MMWAVE";
						subsys-name = "Cellular";
					};
				};
			};

			s2mpg15_gpio {
				gpio-controller;
				#gpio-cells = <0x02>;
				ngpios = <0x0a>;
				gpio-ranges = <0x3f4 0x00 0x00 0x0a>;
				phandle = <0x410>;
			};

			s2mpg15_pinctrl {
				phandle = <0x3f4>;
			};

			s2mpg15_spmic_tm1 {
				compatible = "google,s2mpg15-spmic-thermal";
				#thermal-sensor-cells = <0x01>;
				adc_chan_en = [ff];
				filter_spurious_samples = <0x01>;
				stats_en = [ff];
				phandle = <0x440>;
			};
		};
	};

