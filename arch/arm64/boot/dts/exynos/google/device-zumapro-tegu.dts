			event {
				method = "task_log", "work_log", "cpuidle_log", "suspend_log", "irq_log", "hrtimer_log", "clk_log", "pmu_log", "freq_log", "dm_log", "regulator_log", "thermal_log", "acpm_log", "printk_log";
