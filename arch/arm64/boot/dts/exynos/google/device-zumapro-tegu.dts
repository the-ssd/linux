			reg = <0x00 0x700>;
			enable-method = "psci";
			cpu-idle-states = <0x81>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x2f5>;
			phandle = <0x5c>;
		};

		idle-states {
			entry-method = "arm,psci";

			hayes-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x46>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0x7d0>;
				status = "okay";
				phandle = <0x7f>;
			};

			hunter-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xbe>;
				min-residency-us = <0x9c4>;
				status = "okay";
				phandle = <0x80>;
			};

			hunterelp-cpu-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xeb>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0xdac>;
				status = "okay";
				phandle = <0x81>;
			};
		};
	};

