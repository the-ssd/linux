	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x4e>;
				};

				core1 {
					cpu = <0x50>;
				};

				core2 {
					cpu = <0x52>;
				};

				core3 {
					cpu = <0x54>;
				};

				core4 {
					cpu = <0x56>;
				};

				core5 {
					cpu = <0x58>;
				};

				core6 {
					cpu = <0x5a>;
				};

				core7 {
					cpu = <0x5c>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv9.2";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x7f>;
			capacity-dmips-mhz = <0xc1>;
			dynamic-power-coefficient = <0x46>;
			phandle = <0x4e>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv9.2";
			reg = <0x00 0x100>;
