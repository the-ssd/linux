/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	compatible = "google,ZUMA PRO TEGU", "google,ZUMA PRO";
	interrupt-parent = <0x01>;
	model = "ZUMA PRO TEGU MP on ZUMA PRO";

	avf {

		reference {

			avf {
				secretkeeper_public_key = [a4 01 01 03 27 20 06 21 58 20 67 35 3f f7 a8 33 bb d5 88 69 70 74 07 53 10 8e 05 28 23 31 69 4c 81 dd 2f 34 68 d5 0d 0c 25 86];
			};
		};
	};

	memory@980000000 {
		device_type = "memory";
		reg = <0x09 0x80000000 0x80000000>;
	};

	memory@900000000 {
		device_type = "memory";
		reg = <0x09 0x00 0x80000000>;
	};

	memory@880000000 {
		device_type = "memory";
		reg = <0x08 0x80000000 0x80000000>;
	};

	soc_compatible {

		A0_IPOP {
			description = "A0,IPOP";
			product_id = <0x9875>;
			major = <0x00>;
			minor = <0x00>;
			pkg_mode = <0x01>;
		};

		A1_IPOP {
			description = "A1,IPOP";
			product_id = <0x9875>;
			major = <0x00>;
			minor = <0x01>;
			pkg_mode = <0x01>;
		};
	};

	dsim_modes {
		pll-input = <0x00 0x1770000>;
		pll-optimum = <0x00 0xc65d40>;
		pll-out-range = <0x00 0x3197500 0x01 0x89640200>;
		pll-vco-range = <0x00 0xc4b20100 0x01 0x89640200>;
		p-range = <0x01 0x3f>;
		m-range = <0x40 0x3ff>;
		s-range = <0x00 0x06>;
		k-bits = <0x10>;
		phandle = <0x03>;

		dsim-modes {

			720x1280 {
				mode-name = "720x1280";
				pmsk = <0x02 0x73 0x01 0x9555 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				hs-clk = <0x44c>;
				esc-clk = <0x14>;
			};

			1080x1920 {
				mode-name = "1080x1920";
				pmsk = <0x02 0x73 0x01 0x9555 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				hs-clk = <0x44c>;
				esc-clk = <0x14>;
			};

			1440x3040 {
				mode-name = "1440x3040";
				pmsk = <0x02 0x73 0x01 0x9555 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				hs-clk = <0x44c>;
				esc-clk = <0x14>;
			};

			1440x2960 {
				mode-name = "1440x2960";
				pmsk = <0x03 0x74 0x00 0x6800>;
				hs-clk = <0x5d2>;
				esc-clk = <0x14>;
			};

			1080x2340 {
				mode-name = "1080x2340";
				pmsk = <0x03 0x66 0x01 0x9000>;
				hs-clk = <0x28a>;
				esc-clk = <0x14>;
			};

			1440x3120 {
				mode-name = "1440x3120";
				pmsk = <0x02 0x6e 0x00 0x89ab>;
				hs-clk = <0x542>;
				esc-clk = <0x14>;
			};

			1080x2400 {
				mode-name = "1080x2400";
				pmsk = <0x02 0x75 0x01 0xaaab>;
				hs-clk = <0x460>;
				esc-clk = <0x14>;
			};

			1200x1920 {
				mode-name = "1200x1920";
				pmsk = <0x03 0x97 0x01 0x6800>;
				hs-clk = <0x3c9>;
				esc-clk = <0x14>;
			};

			1080x2424 {
				mode-name = "1080x2424";
				pmsk = <0x02 0xb3 0x02 0x5cab>;
				hs-clk = <0x44e>;
				esc-clk = <0x14>;
			};
		};
	};

	dphy_diags {
		phandle = <0x04>;

		reg_400m {
			diag-name = "reg_400m";
			desc = "Reference voltage-400mV for HS Function control pin";
			help = "0: 380mV, 1: 390mV, 2: 400mV, 3: 410mV, 4: 420mV, 5: 430mV,\n    6: 440mV, 7: 450mV";
			reg-base = "dphy-extra";
			reg-offset = [00 08];
			bit-range = [06 04];
		};

		edge_con {
			diag-name = "edge_con";
			desc = "Cap Peaking Control Registers for clock and 4 data lanes";
			help = "0: Cap-Peaking Off, 1: Low-strength cap-peaking,\n    3: Mid-strength cap-peaking, 7: High-strength cap-peaking";
			reg-base = "dphy";
			reg-offset = [02 08 03 08 04 08 05 08 06 08];
			bit-range = [0e 0c];
		};

		edge_con_dir {
			diag-name = "edge_con_dir";
			desc = "Cap Peaking Direction Control Registers for clock and data lanes";
			help = "0: Forward CapPeaking (@slop high),\n    1: Backward Cap Peaking (@slop low)";
			reg-base = "dphy";
			reg-offset = [02 08 03 08 04 08 05 08 06 08];
			bit-range = [09 09];
		};

		edge_con_en {
			diag-name = "edge_con_en";
			desc = "Cap Peaking Enable Registers for clock and data lanes";
			help = "0: disable, 1: enable";
			reg-base = "dphy";
			reg-offset = [02 08 03 08 04 08 05 08 06 08];
			bit-range = [08 08];
		};

		res_up {
			diag-name = "res_up";
			desc = "High-Speed Driver Up Resistor Control Registers for clock and\n    data lanes";
			help = "0: 43, 1: 46, 2: 49, 3: 52, 4: 56, 5: 60, 7: 73, 8: 30, 9: 31.2,\n    10: 32.5, 11: 34, 12: 35.5, 13: 37, 14: 39, 15: 31";
			reg-base = "dphy";
			reg-offset = [02 08 03 08 04 08 05 08 06 08];
			bit-range = [07 04];
		};

		res_down {
			diag-name = "res_down";
			desc = "High-Speed Driver Down Resistor Control Registers for clock and\n    data lanes";
			help = "0: 43, 1: 46, 2: 49, 3: 52, 4: 56, 5: 60, 7: 73, 8: 30, 9: 31.2,\n    10: 32.5, 11: 34, 12: 35.5, 13: 37, 14: 39, 15: 31";
			reg-base = "dphy";
			reg-offset = [02 08 03 08 04 08 05 08 06 08];
			bit-range = [03 00];
		};

		emp {
			diag-name = "emp";
			desc = "De-Emphasis Control Registers for clock and data lanes";
			help = "0: de-emphasis off, 1: -1.6 dB, 2: -3.5 dB, 3 -6 dB";
			reg-base = "dphy";
			reg-offset = [02 0c 03 0c 04 0c 05 0c 06 0c];
			bit-range = [01 00];
		};

		hs_prepare {
			diag-name = "hs_prepare";
			desc = "THS-PREPARE (D-PHY) Timing Counter Registers for data lanes";
			help = "This count value is used in High-Speed Transmit operation.";
			reg-base = "dphy";
			reg-offset = <0x3340434 0x5340634>;
			bit-range = "\a";
		};

		clk_prepare {
			diag-name = "clk_prepare";
			desc = "TCLK-PREPARE Timing Counter Register";
			help = "This count value is used in High-Speed Transmit operations";
			reg-base = "dphy";
			reg-offset = [02 34];
			bit-range = "\a";
		};
	};

	hs_clock_rates {
		hs-clock-rates = <0x44e 0x3e8>;
		phandle = <0x05>;
	};

