			cpu-idle-states = <0x80>;
			capacity-dmips-mhz = <0x39f>;
			dynamic-power-coefficient = <0x201>;
			phandle = <0x56>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,armv9.2";
			reg = <0x00 0x500>;
